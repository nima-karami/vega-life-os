# Every env var apps/server reads. Nothing loads this file automatically: export the vars,
# or pass them through your runner. In production the Cloud Run service holds them; the
# three marked [secret] come from Secret Manager.

# development | staging | test | production. Anything else reads as development.
NODE_ENV=development

# Firestore database id. Production must use (default); every other NODE_ENV must name
# another database, or the server refuses to start.
FIRESTORE_DB=dev

# GCP project: PROJECT_ID, else GOOGLE_CLOUD_PROJECT, else vega-life-os.
PROJECT_ID=vega-life-os
GOOGLE_CLOUD_PROJECT=

# Listen port. Default 8080 (Cloud Run); the web app expects 8787 when VITE_API_URL is unset.
PORT=8787

# Public base URL of this service: the GCal webhook and the reconcile-task OIDC audience.
PUBLIC_BASE_URL=http://localhost:8787

# Comma-separated origins allowed on /trpc/*. Default: the two Hosting domains + localhost:5180.
CORS_ORIGINS=http://localhost:5180

# Google OAuth web client for Calendar sync. [secret] for the id and secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The web app's callback route, which hands the code back to the server.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5180/calendar/callback

# 32 random bytes, base64, encrypting stored Google refresh tokens. [secret]
# e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GCAL_TOKEN_ENC_KEY=

# Commit sha reported by GET /health. Baked into the image as a build-arg; "dev" when unset.
GIT_SHA=

# Release version (vYYYY.M.N) reported by GET /health. A build-arg set by a release; "dev" when unset.
APP_VERSION=

# Local emulators (read by firebase-admin). Set when running against firebase emulators.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Without the emulators, firebase-admin uses Application Default Credentials: set
# GOOGLE_APPLICATION_CREDENTIALS to a key file, or run `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=
