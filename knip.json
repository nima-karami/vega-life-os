{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "ignoreDependencies": ["@playwright/test"],
      "project": []
    },
    "apps/web": {
      "entry": ["src/**/index.ts"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
