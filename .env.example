# Firebase web app config (Project settings → Your apps → Web app).
# Leave unset to run VEGA fully local (no sync). Copy to .env.local to enable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Web client ID for Calendar sync (Google Cloud Console → Credentials).
# Leave unset to disable calendar sync.
VITE_GOOGLE_CLIENT_ID=
