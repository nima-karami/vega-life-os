# Gate minus e2e (CI runs e2e). Server tests boot the Firestore emulator, which needs JDK 21+.
java_major() { java -version 2>&1 | sed -n '1s/.*version "\([0-9]*\)\(\.\([0-9]*\)\)\{0,1\}.*/\1 \3/p' | awk '{print ($1==1)?$2:$1}'; }

if [ "$(java_major)" -lt 21 ] 2>/dev/null || ! command -v java >/dev/null 2>&1; then
  jdk=$(ls -d "$HOME"/tools/jdk-21*/ 2>/dev/null | head -n 1)
  [ -n "$jdk" ] && PATH="${jdk}bin:$PATH" && export PATH
fi

if ! [ "$(java_major)" -ge 21 ] 2>/dev/null; then
  echo "pre-push: JDK 21+ must be first on PATH (server tests need the Firestore emulator)."
  echo "          e.g. export PATH=\"/c/Users/karam/tools/jdk-21.0.11+10/bin:\$PATH\" and verify with 'java -version'."
  exit 1
fi

npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run test && npm run dupes
