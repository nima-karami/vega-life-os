# Format + lint staged files (auto-fixes; blocks the commit on remaining errors)
npx lint-staged

# Secret scan on staged changes (skips gracefully if gitleaks isn't installed locally)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact || exit 1
else
  echo "gitleaks not on PATH — skipping local secret scan (CI still gates it)"
fi
