{
  "name": "vega-life-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @vega/web",
    "build": "npm run build --workspace @vega/web",
    "preview": "npm run preview --workspace @vega/web",
    "typecheck": "tsc -b",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip --include files,dependencies,unlisted",
    "knip:all": "knip",
    "test": "npm test --workspaces --if-present",
    "dupes": "jscpd apps/web/src apps/server/src packages/shared/src --threshold 5 --reporters console",
    "audit:deps": "npm audit --audit-level=high && osv-scanner scan source --lockfile package-lock.json",
    "scan:secrets": "gitleaks git . --no-banner --redact",
    "sast": "semgrep ci",
    "e2e": "npm run e2e --workspace @vega/web",
    "deploy": "npm run build && npx -y firebase-tools@15 deploy --only hosting --project vega-life-os --non-interactive",
    "deploy:preview": "npm run build && npx -y firebase-tools@15 hosting:channel:deploy preview --expires 7d --project vega-life-os --non-interactive",
    "deploy:rollback": "npx -y firebase-tools@15 hosting:rollback --project vega-life-os",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run test && npm run dupes && npm run scan:secrets && npm run audit:deps && npm run e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8",
    "googleapis-common": {
      "uuid": "^11.1.1"
    }
  }
}
