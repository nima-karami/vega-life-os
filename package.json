{
  "name": "vega-life-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip --include files,dependencies,unlisted",
    "knip:all": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "dupes": "jscpd src --threshold 5 --reporters console",
    "audit:deps": "npm audit --audit-level=high && osv-scanner scan source --lockfile package-lock.json",
    "scan:secrets": "gitleaks git . --no-banner --redact",
    "sast": "semgrep ci",
    "e2e": "playwright test",
    "deploy": "npm run build && npx -y firebase-tools@15 deploy --only hosting --project vega-life-os --non-interactive",
    "deploy:preview": "npm run build && npx -y firebase-tools@15 hosting:channel:deploy preview --expires 7d --project vega-life-os --non-interactive",
    "deploy:rollback": "npx -y firebase-tools@15 hosting:rollback --project vega-life-os",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run test && npm run dupes && npm run scan:secrets && npm run audit:deps && npm run e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extensions": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "firebase": "^12.15.0",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.28.0",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "jsdom": "^25.0.1",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
