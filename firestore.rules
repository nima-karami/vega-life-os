rules_version = '2';

// VEGA Life OS — every document lives under users/{uid}/... .
// A signed-in user may read and write ONLY their own subtree. Nothing else is
// reachable. Without these rules your data is either locked out or world-open.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
